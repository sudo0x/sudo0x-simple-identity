# ============================================================
# Identity Service — Environment Variables
# Copy to .env and fill in production values.
# NEVER commit real secrets to version control.
# ============================================================

# ─── Database ───────────────────────────────────────────────
DATABASE_URL=jdbc:postgresql://localhost:5432/identity
DATABASE_USER=identity
DATABASE_PASSWORD=changeme

# ─── JWT Signing Keys ───────────────────────────────────────
# For production: generate an RSA-2048 key pair and set paths below.
# For local dev:  set both to "generate" to use ephemeral keys.
#
# Generate keys:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
#
JWT_PRIVATE_KEY_LOCATION=file:/run/secrets/jwt_private_key
JWT_PUBLIC_KEY_LOCATION=file:/run/secrets/jwt_public_key
JWT_ISSUER=identity-service

# ─── Token Expiration ───────────────────────────────────────
JWT_ACCESS_TOKEN_EXPIRATION=PT15M
JWT_REFRESH_TOKEN_EXPIRATION=P30D

# ─── Security ───────────────────────────────────────────────
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_DURATION=PT15M

# ─── Password Policy ────────────────────────────────────────
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_DIGIT=true
PASSWORD_REQUIRE_SPECIAL=false

# ─── Email / Tokens ─────────────────────────────────────────
EMAIL_VERIFICATION_EXPIRY=PT24H
PASSWORD_RESET_EXPIRY=PT1H
EMAIL_VERIFICATION_REQUIRED=false

# ─── CORS ───────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://your-app.example.com

# ─── Cookie-based Auth (for browser clients) ────────────────
COOKIE_AUTH_ENABLED=false
COOKIE_SECURE=true
COOKIE_SAME_SITE=Lax
COOKIE_DOMAIN=

# ─── Seed Data (NEVER enable in production) ─────────────────
SEED_ENABLED=false
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=

# ─── Server ─────────────────────────────────────────────────
SERVER_PORT=8080

# ─── Spring Profile ─────────────────────────────────────────
SPRING_PROFILES_ACTIVE=prod
